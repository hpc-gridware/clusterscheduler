# Doxyfile.strict - documentation gate for converted modules
#
# Purpose: this is not a documentation generator, it is a check. It produces no
# output at all. It parses only those modules whose documentation has already
# been converted to doxygen, and turns every documentation defect in them into a
# build error, so a converted module cannot silently regress.
#
# Every setting is inherited from the main Doxyfile below, so project name,
# aliases and language settings never drift between the two files. Only the
# settings that turn "generate" into "verify" are overridden here.
#
# The list of converted modules is NOT maintained in this file - it lives in
# CMakeLists.txt as DXM_FINISHED_MODULES, and is substituted into INPUT below.
#
# Background and rationale:
#   doc/doxygen/Readme-dxm.md
#   vault: 02 Work Projects/22 Doxygen Comment Migration/05 Strict gate Doxyfile.md

@INCLUDE = @CMAKE_CURRENT_BINARY_DIR@/Doxyfile

#---------------------------------------------------------------------------
# Output: as little as doxygen will allow
#
# This configuration exists to produce warnings, not documentation, so ideally
# every GENERATE_* would be NO. Doxygen refuses: with no output format selected
# it emits "No output formats selected!", and because WARN_AS_ERROR is set below
# that one message makes the run fail even when the documentation is perfect.
# The gate would then fail always, which is the same as not having a gate.
#
# So exactly one format is enabled, and man was measured to be the cheapest:
#
#   backend   time     files   size     (source/libs/uti, doxygen 1.15.0)
#   html      722 ms   281     3.1M
#   xml       394 ms   199     3.4M
#   rtf       268 ms     3     584K
#   man       234 ms    60     240K
#
# The choice is safe: html, man and rtf were verified to produce the identical
# set of 475 warnings on source/libs/uti + source/libs/sched, so the backend
# affects only what is written to disk, never what is reported. The output is
# written into the build tree and is meant to be thrown away.
#---------------------------------------------------------------------------

GENERATE_MAN           = YES
GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_XML           = NO
GENERATE_RTF           = NO
GENERATE_DOCBOOK       = NO
GENERATE_AUTOGEN_DEF   = NO
GENERATE_SQLITE3       = NO

OUTPUT_DIRECTORY       = @CMAKE_CURRENT_BINARY_DIR@/doc_doxygen_strict/
QUIET                  = YES

# No diagrams either - they cost time and produce no warnings
HAVE_DOT               = NO

#---------------------------------------------------------------------------
# Input: the whole tree, deliberately
#
# It would seem natural to parse only the converted modules. That does not
# work: a cross reference like #EV_NO_FLUSH can only be resolved if the file
# that defines the symbol was parsed too. With a per module INPUT, every
# reference into a neighbouring module fails with "explicit link request ...
# could not be resolved" and the gate rejects correct documentation.
#
# So the whole tree is parsed - measured at ~3 seconds - and the *warnings* are
# filtered down to the converted modules afterwards by dxm-check.sh.
#
# Consequence worth knowing while the migration is in progress: a #reference to
# a macro in a module that has not been converted yet still fails, because a
# file without an @file block contributes no link targets. Use backticks for
# those and upgrade them to #reference once that module is converted.
#
# INPUT is the one input setting that is NOT inherited unchanged. The main
# Doxyfile covers source/ only, and it stays that way: the module tests under
# test/ are gated but deliberately kept out of the published documentation
# (decision 2026-08-09). Repeating the tag here overrides the value @INCLUDE
# brought along, the same mechanism as EXCLUDE_PATTERNS below.
#
# Without this the tests are invisible to the gate, and invisible in the worst
# way: doxygen reports nothing for a file it never read, which looks exactly
# like a clean file. dxm-check.sh guards against the total case with its
# "parsed no input files" check, but not against a subtree quietly missing.
#---------------------------------------------------------------------------

INPUT                  = ./clusterscheduler/source/ \
                         ./gcs-extensions/source/ \
                         ./clusterscheduler/test/ \
                         ./gcs-extensions/test/

RECURSIVE              = YES

# Message catalogues are excluded from the gate. A msg_*.h file is a flat list
# of _MESSAGE(id, text) entries whose text already says what the entry is for -
# 3232 of them across 41 files - so a per macro comment would restate the
# message string and nothing more. The @file block describing the catalogue as a
# whole is still wanted, and the main Doxyfile still documents these files; only
# the "every macro must be documented" requirement is lifted here.
#
# sge_spooling_flatfile_scanner.cc is flex output, checked in rather than
# regenerated at build time (the CMakeLists only compiles it with -Wno-error).
# It is the only generated scanner or parser in the tree, so it is named
# explicitly instead of matched by a */*_scanner.cc pattern that would also
# swallow a hand written file of that name.
#
# EXCLUDE_PATTERNS is repeated rather than appended because @INCLUDE brings the
# main Doxyfile's value along, and doxygen has no += for it.
EXCLUDE_PATTERNS       = */._* \
                         */msg_*.h \
                         */sge_spooling_flatfile_scanner.cc \
                         */com_sun_grid_drmaa_SessionImpl.h \
                         */jdrmaa/*.java

# main() and usage() exist once per program, with the same signature every time,
# and doxygen treats same-named file-scope functions across translation units as
# ONE symbol for the @param/@return bookkeeping but as SEPARATE symbols for the
# "is documented" check. With more than one program in the tree those two rules
# contradict each other: give every main() a full block and doxygen reports
# duplicate @param sections, give it a brief only and it reports missing @param.
# Documenting `int usage()` in utilbin/gethostname.cc likewise makes
# `void usage()` in libs/comm/test_commlib_issue.cc wrong, and the other way
# round - there is no placement that satisfies both.
#
# Excluded rather than worked around, because neither name carries information
# the @file brief does not already give: main() is the entry point and usage()
# prints the help text. Decision 2026-08-09, when source/utilbin made the first
# five main() functions visible to the gate.
EXCLUDE_SYMBOLS        = main usage

#---------------------------------------------------------------------------
# What has to be documented
#
# EXTRACT_ALL must stay NO: doxygen disables WARN_IF_UNDOCUMENTED when
# EXTRACT_ALL is YES, which would silently switch the whole gate off.
#
# EXTRACT_STATIC stays NO for now. File-local helpers are still documented per
# the house style, they are just not build blockers yet. Flipping this to YES
# is the intended next tightening step once the conversion is complete.
#---------------------------------------------------------------------------

EXTRACT_ALL            = NO
EXTRACT_STATIC         = NO
EXTRACT_PRIVATE        = NO
EXTRACT_PRIV_VIRTUAL   = NO
EXTRACT_PACKAGE        = NO
EXTRACT_LOCAL_METHODS  = NO

#---------------------------------------------------------------------------
# Every documentation defect is an error
#
# FAIL_ON_WARNINGS rather than YES: doxygen reports every problem it finds and
# then exits non-zero, instead of stopping at the first one. That difference
# matters a lot while converting a module.
#
# Note that these checks only see a file that carries a /** @file */ block.
# Without one, doxygen reports nothing at all for that file's free functions -
# not even missing @param tags. Adding the @file block is therefore the first
# step of every module conversion, not a cosmetic afterthought.
#---------------------------------------------------------------------------

WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = YES
WARN_IF_UNDOC_ENUM_VAL = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS

#---------------------------------------------------------------------------
# Preprocessing
#---------------------------------------------------------------------------
# PREDEFINED decides which #if branch doxygen reads, and a branch it does not
# read is invisible to the gate - it reports nothing, which looks exactly like
# a clean file.  The value is repeated here rather than appended because
# @INCLUDE brings the main Doxyfile's along and doxygen has no += for it.
#
# COMPILE_DC added 2026-08-09.  cmake/ArchitectureSpecificSettings.cmake:70
# defines it for every target, but the Doxyfile did not, so doxygen was reading
# the `#if !defined(COMPILE_DC)` branch of daemons/common/pdc.cc - a single
# dummy int - and skipping the ~1200 lines of the process data collector that
# are actually compiled.  execd and shepherd have COMPILE_DC blocks too.
#
# Still not aligned with the build: SECURE and SGE_MT are predefined here but
# the build defines neither (SECURE is commented out in
# cmake/BuildThirdParty.cmake:184).  Left as it is on purpose - documenting a
# branch that is not compiled is the safe direction, and changing it would move
# 16 files in already registered modules.  See task 40 in `07`.
PREDEFINED             = LINUX \
                         TARGET_64BIT \
                         SGE_MT \
                         SECURE \
                         OCS_WITH_OPENSSL \
                         OCS_WITH_MUNGE \
                         OCS_WITH_SYSTEMD \
                         OCS_HWLOC \
                         COMPILE_DC
