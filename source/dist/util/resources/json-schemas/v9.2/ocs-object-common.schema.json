{
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "$id": "https://raw.githubusercontent.com/hpc-gridware/clusterscheduler/master/source/dist/util/resources/json-schemas/v9.2/ocs-object-common.schema.json",
   "$defs": {
      "descriptionBlock": {
         "type": "array",
         "minItems": 1,
         "items": {
            "type": "string",
            "minLength": 1
         }
      },
      "flagName": {
         "type": "string",
         "enum": [
            "CONFIGURE",
            "HASH",
            "NO_TRANSFER",
            "PRIMARY_KEY",
            "SPOOL",
            "SPOOL_PROJECT",
            "SPOOL_SUBLIST",
            "UNIQUE"
         ]
      },
      "flags": {
         "type": "array",
         "uniqueItems": true,
         "items": {
            "$ref": "#/$defs/flagName"
         }
      },
      "attributeType": {
         "type": "string",
         "description": "Allowed low-level attribute type identifiers used in the cull JSON files.",
         "enum": [
            "lBoolT",
            "lDoubleT",
            "lHostT",
            "lIntT",
            "lListT",
            "lLongT",
            "lObjectT",
            "lRefT",
            "lStringT",
            "lTimestampT",
            "lUlong64T",
            "lUlongT"
         ]
      }
   }
}