/** @file
 * @brief The build id, generated by CMake from ocs_build_id.h.in into the build directory
 *
 * The id changes with every testsuite build. Only sge_feature.cc includes this header, so a new id recompiles
 * that one file instead of every source file (CS-3072). Empty when the build passed no CMAKE_BUILD_ID.
 */

/// the build id passed to CMake as CMAKE_BUILD_ID, appended to the version the clients print
#define CMAKE_BUILD_ID "@CMAKE_BUILD_ID@"
