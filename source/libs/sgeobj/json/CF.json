{
   "className": "ConfigurationElement",
   "summary": "Configuration Element",
   "description": [
      "A configuration element contains one line of a configuration, see qconf -sconf, e.g.",
      "- execd_spool_dir",
      "- mailer",
      "- xterm",
      "- load_sensor",
      "- ..."
   ],
   "cullPrefix": "CF",
   "attributes": [
      {
         "name": "name",
         "summary": "Configuration Name",
         "description": [
            "Name of the configuration element (the left column of qconf -sconf)."
         ],
         "type": "lStringT",
         "flags": [
            {
               "name": "PRIMARY_KEY"
            },
            {
               "name": "UNIQUE"
            },
            {
               "name": "HASH"
            },
            {
               "name": "JGDI_CONF"
            },
            {
               "name": "SPOOL_SUBLIST"
            }
         ]
      },
      {
         "name": "value",
         "summary": "Configuration Value",
         "description": [
            "The value of a configuration element (the right column of qconf -sconf)."
         ],
         "type": "lStringT",
         "flags": [
            {
               "name": "JGDI_CONF"
            },
            {
               "name": "SPOOL_SUBLIST"
            }
         ]
      },
      {
         "name": "sublist",
         "summary": "Configuration Sublist",
         "description": [
            "Recursive Sublist of CF_Type. @todo is it still required? It is only used in libs/gdi/sge_qtcsh.cc."
         ],
         "type": "lListT",
         "subClassName": "ANY",
         "subCullPrefix": "ANY",
         "flags": [
            {
               "name": "JGDI_CONF"
            }
         ]
      },
      {
         "name": "local",
         "summary": "Local Configuration",
         "description": [
            "Is it a local configuration (true) or the global configuration (false)."
         ],
         "type": "lUlongT",
         "flags": [
            {
               "name": "JGDI_HIDDEN"
            }
         ]
      }
   ]
}
