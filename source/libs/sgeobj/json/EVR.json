{
   "className": "EventRequest",
   "summary": "Event Master Request",
   "description": [
      {
         "line": "One request queued for the event master thread."
      },
      {
         "line": "Every change to the event master - a client registering, changing its subscription, leaving, or an event being added - is posted as one of these rather than applied directly, so the callers never block on the event master's lock."
      }
   ],
   "cullPrefix": "EVR",
   "attributes": [
      {
         "name": "operation",
         "summary": "Operation",
         "description": [
            {
               "line": "Which request this is: `EVR_ADD_EVC`, `EVR_MOD_EVC`, `EVR_DEL_EVC` or `EVR_ADD_EVENT`. See `sge_event.h`."
            }
         ],
         "type": "lUlongT",
         "flags": []
      },
      {
         "name": "timestamp",
         "summary": "Timestamp",
         "description": [
            {
               "line": "When the request was posted, so the event master can order and age requests."
            }
         ],
         "type": "lTimestampT",
         "flags": []
      },
      {
         "name": "event_client_id",
         "summary": "Event Client Id",
         "description": [
            {
               "line": "Which event client the request is about."
            }
         ],
         "type": "lUlongT",
         "flags": []
      },
      {
         "name": "event_number",
         "summary": "Event Number",
         "description": [
            {
               "line": "The client's event serial the request refers to."
            }
         ],
         "type": "lUlongT",
         "flags": []
      },
      {
         "name": "session",
         "summary": "Session",
         "description": [
            {
               "line": "The session the request belongs to, so a client sees its own changes."
            }
         ],
         "type": "lStringT",
         "flags": []
      },
      {
         "name": "event_client",
         "summary": "Event Client",
         "description": [
            {
               "line": "The event client object (`EV_Type`), for the register and modify operations."
            }
         ],
         "type": "lObjectT",
         "subClassName": "ANY",
         "subCullPrefix": "ANY",
         "flags": []
      },
      {
         "name": "event_list",
         "summary": "Events",
         "description": [
            {
               "line": "The events to deliver (`ET_Type`), for `EVR_ADD_EVENT`."
            }
         ],
         "type": "lListT",
         "subClassName": "ET",
         "subCullPrefix": "ET",
         "flags": []
      }
   ]
}
