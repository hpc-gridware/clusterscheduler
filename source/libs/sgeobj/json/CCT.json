{
   "className": "CategoryCache",
   "summary": "Category Cache Entry",
   "description": [
      {
         "line": "What the scheduler learned about one category while scheduling for one parallel environment."
      },
      {
         "line": "Jobs in a category make identical requests, so a queue or host that rejected the first job rejects them all. Remembering those rejections turns a per-job search into a per-category one, which is where most of the scheduler's speed on a large pending list comes from."
      }
   ],
   "cullPrefix": "CCT",
   "attributes": [
      {
         "name": "pe_name",
         "summary": "Parallel Environment",
         "description": [
            {
               "line": "The parallel environment this cache is for; a category is cached once per PE it was tried with."
            }
         ],
         "type": "lStringT",
         "flags": []
      },
      {
         "name": "ignore_queues",
         "summary": "Rejected Queues",
         "description": [
            {
               "line": "Cluster queues already known not to suit this category (`CTI_Type`), so later jobs skip them."
            }
         ],
         "type": "lListT",
         "subClassName": "SkipListEntry",
         "subCullPrefix": "CTI",
         "flags": []
      },
      {
         "name": "ignore_hosts",
         "summary": "Rejected Hosts",
         "description": [
            {
               "line": "Hosts already known not to suit this category."
            }
         ],
         "type": "lListT",
         "subClassName": "SkipListEntry",
         "subCullPrefix": "CTI",
         "flags": []
      },
      {
         "name": "job_messages",
         "summary": "Scheduler Messages",
         "description": [
            {
               "line": "The \"why not\" messages (`MES_Type`) produced for this category, reused rather than regenerated per job."
            }
         ],
         "type": "lListT",
         "subClassName": "JobSchedulingMessage",
         "subCullPrefix": "MES",
         "flags": []
      },
      {
         "name": "pe_job_slots",
         "summary": "Possible Slot Counts",
         "description": [
            {
               "line": "Reference to the set of slot counts the parallel environment could grant, cached across the category's jobs."
            }
         ],
         "type": "lRefT",
         "subClassName": "ANY",
         "subCullPrefix": "ANY",
         "flags": [
            {
               "name": "NO_TRANSFER"
            }
         ]
      },
      {
         "name": "pe_job_slot_count",
         "summary": "Slot Count Size",
         "description": [
            {
               "line": "How many entries CCT_pe_job_slots holds."
            }
         ],
         "type": "lUlongT",
         "flags": []
      }
   ]
}
