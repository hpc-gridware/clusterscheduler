{
   "className": "AttributeInterval",
   "summary": "Attribute Interval",
   "description": [
      "Used for interval attributes in the cluster queues.",
      "E.g. used for the queue suspend_interval and the notify interval."
   ],
   "cullPrefix": "AINTER",
   "attributes": [
      {
         "name": "href",
         "summary": "Host Reference",
         "description": [
            "Name of a host or a host group."
         ],
         "type": "lHostT",
         "flags": [
            "PRIMARY_KEY",
            "UNIQUE",
            "HASH",
            "SPOOL_SUBLIST"
         ]
      },
      {
         "name": "value",
         "summary": "Value",
         "description": [
            "The interval value (represented as string)."
         ],
         "type": "lStringT",
         "flags": [
            "SPOOL_SUBLIST"
         ]
      }
   ]
}
