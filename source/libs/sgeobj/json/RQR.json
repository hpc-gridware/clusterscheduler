{
   "className": "ResourceQuotaRule",
   "summary": "Resource Quota Rule",
   "description": [
      "One rule of a resource quota set: what it matches, and what it then limits.",
      "The five filters are ANDed. An empty filter matches everything, so a rule with no filters is the catch-all."
   ],
   "cullPrefix": "RQR",
   "attributes": [
      {
         "name": "name",
         "summary": "Name",
         "description": [
            "Optional rule name, so `qquota` and the error messages can say which rule bit."
         ],
         "type": "lStringT",
         "flags": [
            {
               "name": "PRIMARY_KEY"
            },
            {
               "name": "UNIQUE"
            },
            {
               "name": "HASH"
            },
            {
               "name": "JGDI_CONF"
            },
            {
               "name": "SPOOL"
            }
         ]
      },
      {
         "name": "filter_users",
         "summary": "User Filter",
         "description": [
            "Which submitting users the rule applies to (`RQRF_Type`)."
         ],
         "type": "lObjectT",
         "subClassName": "ANY",
         "subCullPrefix": "ANY",
         "flags": [
            {
               "name": "JGDI_CONF"
            },
            {
               "name": "SPOOL"
            }
         ]
      },
      {
         "name": "filter_projects",
         "summary": "Project Filter",
         "description": [
            "Which projects the rule applies to."
         ],
         "type": "lObjectT",
         "subClassName": "ANY",
         "subCullPrefix": "ANY",
         "flags": [
            {
               "name": "JGDI_CONF"
            },
            {
               "name": "SPOOL"
            }
         ]
      },
      {
         "name": "filter_pes",
         "summary": "Parallel Environment Filter",
         "description": [
            "Which parallel environments the rule applies to."
         ],
         "type": "lObjectT",
         "subClassName": "ANY",
         "subCullPrefix": "ANY",
         "flags": [
            {
               "name": "JGDI_CONF"
            },
            {
               "name": "SPOOL"
            }
         ]
      },
      {
         "name": "filter_queues",
         "summary": "Queue Filter",
         "description": [
            "Which cluster queues the rule applies to."
         ],
         "type": "lObjectT",
         "subClassName": "ANY",
         "subCullPrefix": "ANY",
         "flags": [
            {
               "name": "JGDI_CONF"
            },
            {
               "name": "SPOOL"
            }
         ]
      },
      {
         "name": "filter_hosts",
         "summary": "Host Filter",
         "description": [
            "Which execution hosts the rule applies to."
         ],
         "type": "lObjectT",
         "subClassName": "ANY",
         "subCullPrefix": "ANY",
         "flags": [
            {
               "name": "JGDI_CONF"
            },
            {
               "name": "SPOOL"
            }
         ]
      },
      {
         "name": "limit",
         "summary": "Limits",
         "description": [
            "What the rule limits and by how much (`RQRL_Type`), one entry per resource."
         ],
         "type": "lListT",
         "subClassName": "RQRL",
         "subCullPrefix": "RQRL",
         "flags": [
            {
               "name": "JGDI_CONF"
            },
            {
               "name": "SPOOL"
            }
         ]
      },
      {
         "name": "level",
         "summary": "Limit Level",
         "description": [
            "How far the limit is spread: shared by everything matched, or one limit each per host, cluster queue or queue instance. See the `RQR_*` values in `sge_resource_quota.h`."
         ],
         "type": "lUlongT",
         "flags": [
            {
               "name": "JGDI_RO"
            }
         ]
      }
   ]
}
