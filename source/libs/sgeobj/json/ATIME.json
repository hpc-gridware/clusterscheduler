{
   "className": "AttributeTime",
   "summary": "Attribute Time",
   "description": [
      "Used for date/time attributes in the cluster queues.",
      "E.g. used for the queue h_rt, s_rt, h_cpu, ..."
   ],
   "fieldPrefix": "ATIME",
   "attributes": [
      {
         "name": "href",
         "summary": "Host Reference",
         "description": [
            "Name of a host or a host group."
         ],
         "type": "Host",
         "flags": [
            "PRIMARY_KEY",
            "UNIQUE",
            "HASH",
            "SPOOL_SUBLIST"
         ]
      },
      {
         "name": "value",
         "summary": "Value",
         "description": [
            "The date/time value (represented as string)."
         ],
         "type": "String",
         "flags": [
            "SPOOL_SUBLIST"
         ]
      }
   ]
}
