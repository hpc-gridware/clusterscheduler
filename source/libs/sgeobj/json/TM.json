{
   "className": "DateTime",
   "summary": "Date Time",
   "description": [
      "An object of this type represents a timestamp (date and time). It mostly corresponds to the struct tm, see man."
   ],
   "cullPrefix": "TM",
   "attributes": [
      {
         "name": "mday",
         "summary": "Month Day",
         "description": [
            "Day of the month, 1-31 (@todo 32 in the old documentation, does it have a special meaning?)."
         ],
         "type": "lUlongT",
         "flags": []
      },
      {
         "name": "mon",
         "summary": "Month",
         "description": [
            "Month, 0-11."
         ],
         "type": "lUlongT",
         "flags": []
      },
      {
         "name": "year",
         "summary": "Year",
         "description": [
            "The number of years since 1900."
         ],
         "type": "lUlongT",
         "flags": []
      },
      {
         "name": "sec",
         "summary": "Seconds",
         "description": [
            "Seconds, 0-59"
         ],
         "type": "lUlongT",
         "flags": []
      },
      {
         "name": "min",
         "summary": "Minute",
         "description": [
            "Minutes, 0-59"
         ],
         "type": "lUlongT",
         "flags": []
      },
      {
         "name": "hour",
         "summary": "Hor",
         "description": [
            "Hour, 0-23"
         ],
         "type": "lUlongT",
         "flags": []
      },
      {
         "name": "wday",
         "summary": "Week Day",
         "description": [
            "Week day, 0-6."
         ],
         "type": "lUlongT",
         "flags": []
      },
      {
         "name": "yday",
         "summary": "Year Day",
         "description": [
            "Day in the year, 0-365."
         ],
         "type": "lUlongT",
         "flags": []
      },
      {
         "name": "isdst",
         "summary": "Is Daylight Saving Time",
         "description": [
            "Whether daylight saving time is in effect (0 = false, 1 = true)."
         ],
         "type": "lUlongT",
         "flags": []
      }
   ]
