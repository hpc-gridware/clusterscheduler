{
   "className": "XMLDocumentHead",
   "summary": "XML Document Header",
   "description": [
      {
         "line": "The head of a generated XML document: its version, root element name, stylesheets and attributes."
      },
      {
         "line": "Used by the clients' `-xml` output. See `sge_cull_xml.cc`."
      }
   ],
   "cullPrefix": "XMLH",
   "attributes": [
      {
         "name": "Version",
         "summary": "XML Version",
         "description": [
            {
               "line": "The version string written into the XML declaration."
            }
         ],
         "type": "lStringT",
         "flags": []
      },
      {
         "name": "Name",
         "summary": "Root Element Name",
         "description": [
            {
               "line": "Name of the document's root element."
            }
         ],
         "type": "lStringT",
         "flags": []
      },
      {
         "name": "Stylesheet",
         "summary": "Stylesheets",
         "description": [
            {
               "line": "Stylesheet processing instructions (`XMLS_Type`) emitted before the root element."
            }
         ],
         "type": "lListT",
         "subClassName": "XMLS",
         "subCullPrefix": "XMLS",
         "flags": []
      },
      {
         "name": "Attribute",
         "summary": "Root Attributes",
         "description": [
            {
               "line": "Attributes (`XMLA_Type`) placed on the root element, such as the schema location."
            }
         ],
         "type": "lListT",
         "subClassName": "XMLA",
         "subCullPrefix": "XMLA",
         "flags": []
      },
      {
         "name": "Element",
         "summary": "Content",
         "description": [
            {
               "line": "The document body (`XMLE_Type`)."
            }
         ],
         "type": "lListT",
         "subClassName": "ANY",
         "subCullPrefix": "ANY",
         "flags": []
      }
   ]
}
