{
   "className": "ResourceQuotaSet",
   "summary": "Resource Quota Set",
   "description": [
      {
         "line": "A named, enableable set of rules that limit resource use across the object model."
      },
      {
         "line": "Where a queue or host limits what it can give, a resource quota set limits what a *combination* may take - \"this project may use 100 slots in total, wherever they are\". The rules are tried in order and the first that matches decides."
      }
   ],
   "cullPrefix": "RQS",
   "attributes": [
      {
         "name": "name",
         "summary": "Name",
         "description": [
            {
               "line": "The set's name, as used by `qconf -mrqs`."
            }
         ],
         "type": "lStringT",
         "flags": [
            {
               "name": "PRIMARY_KEY"
            },
            {
               "name": "UNIQUE"
            },
            {
               "name": "HASH"
            },
            {
               "name": "JGDI_CONF"
            },
            {
               "name": "SPOOL"
            }
         ]
      },
      {
         "name": "description",
         "summary": "Description",
         "description": [
            {
               "line": "Free text describing what the set is for."
            }
         ],
         "type": "lStringT",
         "flags": [
            {
               "name": "JGDI_CONF"
            },
            {
               "name": "SPOOL"
            }
         ]
      },
      {
         "name": "enabled",
         "summary": "Enabled",
         "description": [
            {
               "line": "Whether the set is applied. A disabled set stays configured but limits nothing."
            }
         ],
         "type": "lBoolT",
         "flags": [
            {
               "name": "JGDI_CONF"
            },
            {
               "name": "SPOOL"
            }
         ]
      },
      {
         "name": "rule",
         "summary": "Rules",
         "description": [
            {
               "line": "The rules (`RQR_Type`), in the order they are tried."
            }
         ],
         "type": "lListT",
         "subClassName": "RQR",
         "subCullPrefix": "RQR",
         "flags": [
            {
               "name": "JGDI_CONF"
            },
            {
               "name": "SPOOL"
            }
         ]
      },
      {
         "name": "joker",
         "summary": "Joker",
         "description": [
            {
               "line": "Placeholder which can be used for arbitrary data."
            },
            {
               "line": "Its purpose is to be able to add new attributes without changing the spooling format."
            },
            {
               "line": "It is a list of arbitrary type and it is spooled."
            }
         ],
         "type": "lListT",
         "subClassName": "Variable",
         "subCullPrefix": "VA",
         "flags": [
            {
               "name": "SPOOL"
            }
         ]
      }
   ]
}
