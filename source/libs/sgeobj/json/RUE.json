{
   "className": "ResourceUtilization",
   "summary": "Resource Utilization",
   "description": [
      "Utilization of a certain resource.",
      "Both the current utilization can be stored, as well as",
      "future utilization (due to currently running jobs,",
      "advance reservations and resource reservations)."
   ],
   "cullPrefix": "RUE",
   "attributes": [
      {
         "name": "name",
         "summary": "Resource Name",
         "description": [
            "The name of the resource (= the name of the complex variable, e.g. slots)"
         ],
         "type": "lStringT",
         "flags": [
            {
               "name": "PRIMARY_KEY"
            },
            {
               "name": "UNIQUE"
            },
            {
               "name": "HASH"
            },
            {
               "name": "SPOOL"
            },
            {
               "name": "SPOOL_SUBLIST"
            }
         ]
      },
      {
         "name": "utilized_now",
         "summary": "Utilized Now",
         "description": [
            "Currently used amount."
         ],
         "type": "lDoubleT",
         "flags": []
      },
      {
         "name": "utilized_now_resource_map_list",
         "summary": "Utilized Now Resource Map List",
         "description": [
            "Currently used amount of Resource Maps"
         ],
         "type": "lListT",
         "subClassName": "RESL",
         "subCullPrefix": "RESL",
         "flags": []
      },
      {
         "name": "utilized_now_binding_inuse",
         "summary": "Utilized Now Binding In Use",
         "description": [
            "Topology string with lowercase core/threads that are currently in use."
         ],
         "type": "lStringT",
         "flags": []
      },
      {
         "name": "utilized",
         "summary": "Utilized",
         "description": [
            "A resource diagram indicating future utilization."
         ],
         "type": "lListT",
         "subClassName": "RDE",
         "subCullPrefix": "RDE",
         "flags": []
      },
      {
         "name": "utilized_now_nonexclusive",
         "summary": "Utilized Now Non-Exclusive",
         "description": [
            "Currently used amount of implicitly used exclusive resources."
         ],
         "type": "lDoubleT",
         "flags": []
      },
      {
         "name": "utilized_nonexclusive",
         "summary": "Utilized Non-Exclusive",
         "description": [
            "A resource diagram indicating future utilization of implicitly used exclusive resources."
         ],
         "type": "lListT",
         "subClassName": "RDE",
         "subCullPrefix": "RDE",
         "flags": []
      }
   ]
}
