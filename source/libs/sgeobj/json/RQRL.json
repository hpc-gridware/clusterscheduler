{
   "className": "ResourceQuotaRuleLimit",
   "summary": "Resource Quota Rule Limit",
   "description": [
      {
         "line": "One resource a rule limits, the configured ceiling, and what is currently booked against it."
      }
   ],
   "cullPrefix": "RQRL",
   "attributes": [
      {
         "name": "name",
         "summary": "Resource Name",
         "description": [
            {
               "line": "The complex attribute being limited, e.g. `slots`."
            }
         ],
         "type": "lStringT",
         "flags": [
            {
               "name": "PRIMARY_KEY"
            },
            {
               "name": "UNIQUE"
            },
            {
               "name": "HASH"
            },
            {
               "name": "JGDI_CONF"
            },
            {
               "name": "SPOOL"
            }
         ]
      },
      {
         "name": "value",
         "summary": "Configured Value",
         "description": [
            {
               "line": "The limit as configured, still as text. For a dynamic limit this is the formula rather than a number."
            }
         ],
         "type": "lStringT",
         "flags": [
            {
               "name": "JGDI_CONF"
            },
            {
               "name": "SPOOL"
            }
         ]
      },
      {
         "name": "type",
         "summary": "Value Type",
         "description": [
            {
               "line": "The complex attribute's type, copied from `CE_valtype`, which decides how RQRL_value is parsed."
            }
         ],
         "type": "lUlongT",
         "flags": [
            {
               "name": "JGDI_RO"
            },
            {
               "name": "SPOOL"
            }
         ]
      },
      {
         "name": "dvalue",
         "summary": "Evaluated Value",
         "description": [
            {
               "line": "The limit as a number. For a static limit this is RQRL_value parsed; for a dynamic one it is the formula evaluated against the host currently being considered."
            }
         ],
         "type": "lDoubleT",
         "flags": [
            {
               "name": "JGDI_RO"
            },
            {
               "name": "SPOOL"
            }
         ]
      },
      {
         "name": "usage",
         "summary": "Usage",
         "description": [
            {
               "line": "What is booked against this limit right now (`RUE_Type`), one entry per name when the filter expands."
            }
         ],
         "type": "lListT",
         "subClassName": "RUE",
         "subCullPrefix": "RUE",
         "flags": [
            {
               "name": "JGDI_RO"
            }
         ]
      },
      {
         "name": "dynamic",
         "summary": "Dynamic",
         "description": [
            {
               "line": "The limit is a formula over host complexes rather than a constant, so RQRL_dvalue has to be recomputed per host instead of read once."
            }
         ],
         "type": "lBoolT",
         "flags": [
            {
               "name": "JGDI_RO"
            }
         ]
      }
   ]
}
