{
   "className": "AttributeMemory",
   "summary": "Attribute Memory",
   "description": [
      "Used for memory attributes in the cluster queues.",
      "E.g. used for the queue s_fsize, h_fsize, s_data, s_stack, ..."
   ],
   "cullPrefix": "AMEM",
   "attributes": [
      {
         "name": "href",
         "summary": "Host Reference",
         "description": [
            "Name of a host or a host group."
         ],
         "type": "lHostT",
         "flags": [
            "PRIMARY_KEY",
            "UNIQUE",
            "HASH",
            "SPOOL_SUBLIST"
         ]
      },
      {
         "name": "value",
         "summary": "Value",
         "description": [
            "The memory value (represented as string)."
         ],
         "type": "lStringT",
         "flags": [
            "SPOOL_SUBLIST"
         ]
      }
   ]
}
